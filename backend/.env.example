# Copy to backend/.env and adjust. Every setting is optional.

# Where Hunterly keeps its database, Gmail token and secret (default ~/.hunterly)
# HUNTERLY_DATA_DIR=~/.hunterly

# Drafts: local model served by Ollama
HUNTERLY_OLLAMA_MODEL=llama3.2:3b
# HUNTERLY_OLLAMA_URL=http://127.0.0.1:11434

# Guardrails
# HUNTERLY_DAILY_CAPTURE_CAP=30
# HUNTERLY_DAILY_FIRST_EMAIL_CAP=20
# HUNTERLY_MAX_MESSAGES_PER_CONTACT=3
# HUNTERLY_FOLLOWUP_DAYS=[4, 9]

# Mail-server checks. If `uv run hunterly port25` says blocked, run the verifier on a VM
# and reach it through an SSH tunnel (see README):
# HUNTERLY_VERIFIER_URL=http://127.0.0.1:8766
# HUNTERLY_VERIFIER_KEY=change-me-long-random-string
# When checking from this machine instead, use a hostname you control:
# HUNTERLY_SMTP_HELO_HOST=mail.example.com
# HUNTERLY_SMTP_MAIL_FROM=verify@example.com
# HUNTERLY_SMTP_CHECKS_PER_DOMAIN_PER_HOUR=20

# Gmail API client file (default <data dir>/credentials.json)
# HUNTERLY_GMAIL_CREDENTIALS_FILE=~/.hunterly/credentials.json
