# Copy to backend/.env and adjust. Every setting is optional.

# Where QL keeps its database, Gmail token and secret (default ~/.ql)
# QL_DATA_DIR=~/.ql

# Drafts: local model served by Ollama
QL_OLLAMA_MODEL=llama3.2:3b
# QL_OLLAMA_URL=http://127.0.0.1:11434

# Guardrails
# QL_DAILY_CAPTURE_CAP=30
# QL_DAILY_FIRST_EMAIL_CAP=20
# QL_MAX_MESSAGES_PER_CONTACT=3
# QL_FOLLOWUP_DAYS=[4, 9]

# Mail-server checks. If `uv run ql port25` says blocked, run the verifier on a VM
# and reach it through an SSH tunnel (see README):
# QL_VERIFIER_URL=http://127.0.0.1:8766
# QL_VERIFIER_KEY=change-me-long-random-string
# When checking from this machine instead, use a hostname you control:
# QL_SMTP_HELO_HOST=mail.example.com
# QL_SMTP_MAIL_FROM=verify@example.com
# QL_SMTP_CHECKS_PER_DOMAIN_PER_HOUR=20

# Gmail API client file (default <data dir>/credentials.json)
# QL_GMAIL_CREDENTIALS_FILE=~/.ql/credentials.json
